{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行 Agent（输入问题）",
      "type": "debugpy",
      "request": "launch",
      "module": "paper_agent",
      "args": ["${input:task}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "运行 Agent（LangChain 版）",
      "type": "debugpy",
      "request": "launch",
      "module": "paper_agent",
      "args": ["--impl", "langchain", "${input:task}"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "跑全部评测",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/run_eval.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "跑单道评测题",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/run_eval.py",
      "args": ["--only", "${input:evalTask}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "单元测试（离线，不花钱）",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-v", "tests"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "task",
      "type": "promptString",
      "description": "要问 Agent 的问题",
      "default": "论文 2308.04079 在 Mip-NeRF360 上的 PSNR 是多少？"
    },
    {
      "id": "evalTask",
      "type": "pickString",
      "description": "选一道评测题",
      "options": [
        "find_3dgs",
        "find_nerf",
        "find_sam",
        "find_transformer",
        "ambiguous_gaussianeditor",
        "number_3dgs_psnr",
        "number_sam_images",
        "negative_scannet",
        "note_3dgs",
        "search_then_read"
      ],
      "default": "number_3dgs_psnr"
    }
  ]
}
